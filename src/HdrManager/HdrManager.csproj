<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0-windows</TargetFramework>
		<RootNamespace>HdrManager</RootNamespace>
		<AssemblyName>HdrManager</AssemblyName>
		<OutputType>Library</OutputType>
		<UseWPF>true</UseWPF>
		<EnableDynamicLoading>true</EnableDynamicLoading>
	</PropertyGroup>

	<PropertyGroup>
		<AssetsDir>$(SolutionDir)</AssetsDir>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
		<PackageReference Include="Playnite.SDK" Version="11.0.0-zeta10" />
		<ProjectReference Include="..\HdrManager.Generator\HdrManager.Generator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
	</ItemGroup>

	<ItemGroup>
		<!-- Extension metadata -->
		<None Include="$(AssetsDir)extension.toml" CopyToOutputDirectory="PreserveNewest" />
		<None Include="$(AssetsDir)icon.png">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<TargetPath>icon.png</TargetPath>
		</None>
		<None Include="$(AssetsDir)README.md" CopyToOutputDirectory="PreserveNewest" />

		<!-- Localization files -->
		<None Include="Localization\*.ftl" CopyToOutputDirectory="PreserveNewest" />

		<!-- Localization file for LocalizationKeys generator -->
		<AdditionalFiles Include="Localization\en_US.ftl" />
	</ItemGroup>

</Project>